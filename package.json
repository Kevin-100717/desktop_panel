{
  "name": "desktop-panel",
  "private": true,
  "version": "1.0.2",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "nodemon --exec electron . --watch ./ --ext .js",
    "electron:dev": "npm-run-all --parallel dev electron",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "systeminformation": "^5.33.6",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "41.0.3",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  },
  "build": {
    "productName": "desktop-panel",
    "appId": "desktop-panel",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Kevin-100717",
      "repo": "desktop_panel"
    },
    "asarUnpack": [
      "node_modules/@koromix/**",
      "node_modules/koffi/**",
      "node_modules/electron-updater/**"
    ],
    "directories": {
      "output": "dist_electron/${version}"
    },
    "files": [
      "dist",
      "electron"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "your.app.category.type"
    },
    "win": {
      "icon": "./electron/log.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {}
  }
}
